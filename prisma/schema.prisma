generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  BRANCH_MANAGER
  TECHNICIAN
  STAFF
  CUSTOMER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum TicketStatus {
  NEW
  CONFIRMED
  ASSIGNED
  ON_THE_WAY
  REACHED_CUSTOMER
  IN_PROGRESS
  WAITING_FOR_PART
  COMPLETED
  PAYMENT_PENDING
  RESCHEDULED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  WALLET
  CHEQUE
  PAYMENT_LINK
  OTHER
}

enum InventoryMovementType {
  PURCHASE
  SERVICE_USAGE
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  DAMAGE
  ADJUSTMENT
}

enum AmcStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  CANCELLED
}

model Business {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  ownerName       String
  email           String
  phone           String
  address         String?
  city            String?
  state           String?
  country         String   @default("India")
  gstNumber       String?
  currency        String   @default("INR")
  language        String   @default("en")
  timezone        String   @default("Asia/Kolkata")
  trialEndsAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
  branches        Branch[]
  customers       Customer[]
  purifierUnits   PurifierUnit[]
  serviceRequests ServiceRequest[]
  technicians     Technician[]
  amcPlans        AmcPlan[]
  customerAmcs    CustomerAmc[]
  inventoryItems  InventoryItem[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  complaints      Complaint[]
  reminders       Reminder[]
  subscriptions   Subscription[]
  auditLogs       AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole @default(OWNER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  technician   Technician?
  @@index([businessId])
}

model SubscriptionPlan {
  id             String @id @default(cuid())
  code           String @unique
  name           String
  monthlyPrice   Int
  annualPrice    Int
  branchLimit    Int
  technicianLimit Int
  customerLimit  Int
  ticketLimit    Int
  features       Json
  subscriptions  Subscription[]
}

model Subscription {
  id        String @id @default(cuid())
  businessId String
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([businessId])
}

model Branch {
  id          String @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  address     String?
  city        String?
  serviceArea String?
  isMain      Boolean @default(false)
  createdAt   DateTime @default(now())
  technicians Technician[]
  serviceRequests ServiceRequest[]
  inventoryItems InventoryItem[]
  @@index([businessId])
}

model Customer {
  id                String @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerCode      String
  name              String
  phone             String
  alternatePhone    String?
  email             String?
  address           String
  landmark          String?
  city              String?
  postalCode        String?
  customerType      String @default("Residential")
  preferredLanguage String @default("English")
  notes             String?
  accountBalance    Decimal @default(0) @db.Decimal(12,2)
  totalSpending     Decimal @default(0) @db.Decimal(12,2)
  lastServiceDate   DateTime?
  nextServiceDate   DateTime?
  tags              String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  purifierUnits     PurifierUnit[]
  serviceRequests   ServiceRequest[]
  amcs              CustomerAmc[]
  invoices          Invoice[]
  complaints        Complaint[]
  reminders         Reminder[]
  @@unique([businessId, customerCode])
  @@index([businessId, phone])
  @@index([businessId, name])
}

model PurifierUnit {
  id              String @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purifierCode    String
  brand           String
  model           String?
  serialNumber    String?
  purifierType    String
  installationDate DateTime?
  installationAddress String?
  warrantyExpiry  DateTime?
  amcExpiry       DateTime?
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  currentTds      Int?
  previousTds     Int?
  storageCapacity String?
  filterConfiguration String?
  membraneType    String?
  pumpModel       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serviceRequests ServiceRequest[]
  amcs            CustomerAmc[]
  @@unique([businessId, purifierCode])
  @@index([businessId, customerId])
}

model Technician {
  id             String @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String? @unique
  user           User? @relation(fields: [userId], references: [id])
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id])
  technicianCode String
  name           String
  phone          String
  email          String?
  address        String?
  skills         String[]
  serviceArea    String?
  employmentType String @default("Full-time")
  joiningDate    DateTime?
  salary         Decimal? @db.Decimal(12,2)
  commissionPct  Decimal @default(0) @db.Decimal(5,2)
  available      Boolean @default(true)
  rating         Decimal @default(5) @db.Decimal(3,2)
  completedJobs  Int @default(0)
  revenueGenerated Decimal @default(0) @db.Decimal(12,2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  serviceRequests ServiceRequest[]
  complaints      Complaint[]
  @@unique([businessId, technicianCode])
  @@index([businessId, name])
}

model ServiceRequest {
  id              String @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch? @relation(fields: [branchId], references: [id])
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  purifierUnitId  String?
  purifierUnit    PurifierUnit? @relation(fields: [purifierUnitId], references: [id])
  technicianId    String?
  technician      Technician? @relation(fields: [technicianId], references: [id])
  ticketNumber    String
  serviceType     String
  problemDescription String
  priority        Priority @default(NORMAL)
  status          TicketStatus @default(NEW)
  preferredDate   DateTime?
  preferredTime   String?
  scheduledAt     DateTime?
  completedAt     DateTime?
  serviceFee      Decimal @default(0) @db.Decimal(12,2)
  estimatedPartsCost Decimal @default(0) @db.Decimal(12,2)
  paymentStatus   PaymentStatus @default(UNPAID)
  customerNotes   String?
  internalNotes   String?
  beforeTds       Int?
  afterTds        Int?
  checklist       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  invoice         Invoice?
  complaints      Complaint[]
  statusHistory   ServiceStatusHistory[]
  @@unique([businessId, ticketNumber])
  @@index([businessId, status])
  @@index([businessId, scheduledAt])
}

model ServiceStatusHistory {
  id        String @id @default(cuid())
  serviceRequestId String
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  status    TicketStatus
  note      String?
  changedBy String?
  createdAt DateTime @default(now())
}

model AmcPlan {
  id                String @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  durationMonths    Int
  price             Decimal @db.Decimal(12,2)
  freeServices      Int
  serviceFrequencyDays Int
  includedFilters   Boolean @default(false)
  includedMembrane  Boolean @default(false)
  includedParts     Boolean @default(false)
  emergencyVisits   Int @default(0)
  discountPct       Decimal @default(0) @db.Decimal(5,2)
  terms             String?
  taxPct            Decimal @default(18) @db.Decimal(5,2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  customerAmcs      CustomerAmc[]
  @@index([businessId])
}

model CustomerAmc {
  id               String @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  purifierUnitId   String
  purifierUnit     PurifierUnit @relation(fields: [purifierUnitId], references: [id])
  planId           String
  plan             AmcPlan @relation(fields: [planId], references: [id])
  amcNumber        String
  startDate        DateTime
  expiryDate       DateTime
  amount           Decimal @db.Decimal(12,2)
  paymentStatus    PaymentStatus @default(UNPAID)
  servicesIncluded Int
  servicesUsed     Int @default(0)
  nextVisitAt      DateTime?
  status           AmcStatus @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([businessId, amcNumber])
  @@index([businessId, expiryDate])
}

model InventoryItem {
  id             String @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch? @relation(fields: [branchId], references: [id])
  sku            String
  name           String
  category       String
  brand          String?
  supplier       String?
  purchasePrice  Decimal @db.Decimal(12,2)
  sellingPrice   Decimal @db.Decimal(12,2)
  taxRate        Decimal @default(18) @db.Decimal(5,2)
  currentStock   Int @default(0)
  minimumStock   Int @default(5)
  reorderQuantity Int @default(10)
  batchNumber    String?
  warrantyMonths Int?
  expiryDate     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  movements      InventoryMovement[]
  invoiceItems   InvoiceItem[]
  @@unique([businessId, sku])
  @@index([businessId, category])
}

model InventoryMovement {
  id           String @id @default(cuid())
  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type         InventoryMovementType
  quantity     Int
  reference    String?
  note         String?
  createdAt    DateTime @default(now())
}

model Invoice {
  id               String @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  serviceRequestId String? @unique
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  invoiceNumber    String
  subtotal         Decimal @db.Decimal(12,2)
  discount         Decimal @default(0) @db.Decimal(12,2)
  tax              Decimal @default(0) @db.Decimal(12,2)
  total            Decimal @db.Decimal(12,2)
  paidAmount       Decimal @default(0) @db.Decimal(12,2)
  balanceAmount    Decimal @db.Decimal(12,2)
  paymentStatus    PaymentStatus @default(UNPAID)
  dueDate          DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  items            InvoiceItem[]
  payments         Payment[]
  @@unique([businessId, invoiceNumber])
  @@index([businessId, createdAt])
}

model InvoiceItem {
  id              String @id @default(cuid())
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String
  quantity        Int @default(1)
  unitPrice       Decimal @db.Decimal(12,2)
  taxRate         Decimal @default(0) @db.Decimal(5,2)
  total           Decimal @db.Decimal(12,2)
}

model Payment {
  id          String @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  amount      Decimal @db.Decimal(12,2)
  method      PaymentMethod
  reference   String?
  receivedAt  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  @@index([businessId, receivedAt])
}

model Expense {
  id          String @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    String
  description String
  amount      Decimal @db.Decimal(12,2)
  incurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  @@index([businessId, incurredAt])
}

model Complaint {
  id               String @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  technicianId     String?
  technician       Technician? @relation(fields: [technicianId], references: [id])
  complaintNumber  String
  category         String
  description      String
  priority         Priority @default(NORMAL)
  status           String @default("Open")
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([businessId, complaintNumber])
  @@index([businessId, status])
}

model Reminder {
  id          String @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String
  channel     String @default("WhatsApp")
  scheduledAt DateTime
  status      String @default("Scheduled")
  message     String
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  @@index([businessId, scheduledAt])
}

model AuditLog {
  id         String @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  @@index([businessId, createdAt])
}
